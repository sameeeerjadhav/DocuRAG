# Backend only. Never put this key in the React app.
GEMINI_API_KEY=your_key_here

# Optional overrides. Defaults are gemini-3.8-flash and gemini-embedding-001.
# GEMINI_CHAT_MODEL=gemini-3.8-flash
# GEMINI_EMBED_MODEL=gemini-embedding-001

# Used by local uvicorn. Docker Compose sets this to /data/chroma itself.
# CHROMA_PERSIST_DIR=./chroma_data

# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
